<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- Netzverkehr pro Prozess: PDH kennt dafür keine Zähler, ETW ist unter
         Windows der einzige Weg. -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.5" />
    <!-- Version an die transitive Anforderung von LibreHardwareMonitorLib angeglichen. -->
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

</Project>
